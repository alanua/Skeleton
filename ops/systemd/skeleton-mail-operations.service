[Unit]
Description=Skeleton Mail Operations worker
Documentation=file:/opt/skeleton-mail-operations/MAIL_OPERATIONS.md
After=network-online.target

[Service]
Type=oneshot
User=agent
Group=agent
Environment=SKELETON_MAIL_ACCOUNT=/var/lib/skeleton/mail/account.json
LoadCredentialEncrypted=skeleton-secret-reference-index:/etc/credstore.encrypted/skeleton-mail-operations.service/skeleton-secret-reference-index
LoadCredentialEncrypted=bitwarden-access-token:/etc/credstore.encrypted/skeleton-mail-operations.service/bitwarden-access-token
ExecStart=/opt/skeleton-mail-operations/bitwarden-sdk-runtime/bin/python /opt/skeleton-mail-operations/mail_operations_worker.py --account ${SKELETON_MAIL_ACCOUNT} tick
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/skeleton /home/agent/.local/state/skeleton-runner
