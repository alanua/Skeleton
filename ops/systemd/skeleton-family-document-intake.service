[Unit]
Description=Skeleton private family document intake
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/Skeleton/scripts/family_document_worker.py --config %h/.config/skeleton/family-document-intake.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/skeleton %h/Documents
UMask=0077

[Install]
WantedBy=default.target
