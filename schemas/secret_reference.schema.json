{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/secret_reference.schema.json",
  "title": "Skeleton Secret Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "reference_id"],
  "properties": {
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "reference_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{2,255}$"
    },
    "version": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{2,255}$"
    }
  }
}
