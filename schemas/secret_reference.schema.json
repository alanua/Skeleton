{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/secret_reference.schema.json",
  "title": "Provider-neutral Secret Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "reference_id"],
  "properties": {
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "reference_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/@-]{2,255}$"
    },
    "version": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/@-]{2,255}$"
    },
    "purpose": {
      "const": "openhands_openrouter_api_key"
    }
  }
}
