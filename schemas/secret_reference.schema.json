{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.secret_reference.schema.json",
  "title": "Skeleton Secret Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "secret_type", "scope"],
  "properties": {
    "schema": {
      "const": "skeleton.secret_reference.v1"
    },
    "kind": {
      "const": "secret_reference"
    },
    "secret_type": {
      "enum": ["google_sheets_credentials"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "dataset", "repo", "branch", "task"],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
