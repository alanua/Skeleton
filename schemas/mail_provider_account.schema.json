{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.mail_provider_account.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "alias", "credential_ref"],
  "properties": {
    "schema": {"const": "skeleton.mail_provider.account.v1"},
    "provider": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,31}$"},
    "alias": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
    "credential_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["env", "file"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "poll_interval_seconds": {"type": "integer", "minimum": 60, "maximum": 3600, "default": 300},
    "cleanup_enabled": {"type": "boolean", "default": false},
    "label_after_handoff": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    }
  }
}
