{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Skeleton Runner vNext GREEN Handoff Receipt","type":"object","additionalProperties":false,"required":["schema","task_id","node_id","node_generation","node_snapshot_hash","node_attestation_ref","node_expires_at","lane","fence_token","environment_policy_hash","operation_id","idempotency_key","adapter_id","policy_reason_code","reservation_scope_hash","authorization_status","lease_retained","ledger_reserved","execution_authorized","side_effects_executed"],"properties":{"schema":{"const":"skeleton.runner_green_handoff_receipt.v1"},"task_id":{"type":"string","pattern":"^task:[A-Za-z0-9._-]+$"},"node_id":{"type":"string","pattern":"^node:[A-Za-z0-9._-]+$"},"node_generation":{"type":"integer","minimum":1},"lane":{"enum":["codegen","validate","publish","merge","control","privileged"]},"fence_token":{"type":"integer","minimum":1},"environment_policy_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"operation_id":{"type":"string","minLength":3},"idempotency_key":{"type":"string","minLength":3},"adapter_id":{"type":"string","minLength":3},"policy_reason_code":{"type":"string","pattern":"^[A-Z0-9_]+$"},"reservation_scope_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"authorization_status":{"const":"AUTHORIZED_GREEN_BOUNDED"},"lease_retained":{"const":true},"ledger_reserved":{"const":true},"execution_authorized":{"const":true},"side_effects_executed":{"const":false},"node_snapshot_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"node_attestation_ref":{"type":"string","minLength":3},"node_expires_at":{"type":"number"}}}
