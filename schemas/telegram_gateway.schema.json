{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.telegram_gateway.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_id", "access_modes"],
  "properties": {
    "schema": {
      "const": "skeleton.telegram_gateway.v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "access_modes": {
      "type": "array",
      "items": {
        "enum": ["READ_PUBLIC", "READ_ALLOWED_PRIVATE", "WRITE_BOT"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "operator_secret_route": {
      "const": "home_edge_devices_secrets_tab_to_bitwarden"
    }
  }
}
