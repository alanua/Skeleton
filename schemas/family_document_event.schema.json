{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.family_document_event.v1",
  "type": "object",
  "required": ["schema", "event_type", "date", "title", "confidence", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "skeleton.family_document_event.v1"},
    "event_type": {
      "enum": ["appointment", "hearing", "deadline", "expiration_renewal", "contract_boundary", "employment_boundary", "insurance_boundary", "booked_travel", "birthday"]
    },
    "date": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}){0,2}$"},
    "title": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "string", "minLength": 1}
  }
}
