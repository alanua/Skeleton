    "route": {"enum": ["ACCEPT", "REVIEW"]},
    "principal_subject_alias": {"type": ["string", "null"]},
    "linked_subject_aliases": {"type": "array", "items": {"type": "string"}},
    "topic_alias": {"type": ["string", "null"]},
    "jurisdiction_country": {"type": ["string", "null"]},
    "document_date": {"type": ["string", "null"]},
    "date_precision": {"enum": ["day", "month", "year", "unknown"]},
    "document_type": {"type": ["string", "null"]},
    "issuer": {"type": ["string", "null"]},
    "summary": {"type": "string"},
    "confidence": {"type": "object"},
    "evidence": {"type": "object"},
    "event_candidates": {"type": "array"},
    "reason_codes": {"type": "array", "items": {"type": "string"}}
  }
}
