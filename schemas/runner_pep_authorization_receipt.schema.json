{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Skeleton Runner vNext PEP Authorization Receipt","type":"object","additionalProperties":false,"required":["schema","adapter_id","operation_id","target_state_ref","fence_token","idempotency_key","effect_class","policy_reason_code","authorization_status","side_effects_executed"],"properties":{"schema":{"const":"skeleton.runner_pep_authorization_receipt.v1"},"adapter_id":{"type":"string","minLength":1},"operation_id":{"type":"string","minLength":1},"target_state_ref":{"type":"string","minLength":1},"fence_token":{"type":"integer","minimum":1},"idempotency_key":{"type":"string","minLength":1},"effect_class":{"const":"GREEN"},"policy_reason_code":{"type":"string","pattern":"^[A-Z0-9_]+$"},"authorization_status":{"const":"AUTHORIZED_GREEN_BOUNDED"},"side_effects_executed":{"const":false}}}
