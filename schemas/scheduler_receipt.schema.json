{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/schemas/scheduler_receipt.schema.json",
  "title": "Skeleton Scheduler Tick Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "evaluated_schedules",
    "created_occurrences",
    "replayed_occurrences",
    "recovered_stale_running",
    "states",
    "public_safe",
    "private_payloads_included",
    "external_side_effects_executed"
  ],
  "properties": {
    "schema": {"const": "skeleton.scheduler_tick_receipt.v1"},
    "status": {"const": "DONE"},
    "evaluated_schedules": {"type": "integer", "minimum": 0},
    "created_occurrences": {"type": "integer", "minimum": 0},
    "replayed_occurrences": {"type": "integer", "minimum": 0},
    "recovered_stale_running": {"type": "integer", "minimum": 0},
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "running", "done", "failed", "needs_operator", "skipped"],
      "properties": {
        "pending": {"type": "integer", "minimum": 0},
        "running": {"type": "integer", "minimum": 0},
        "done": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "needs_operator": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "public_safe": {"const": true},
    "private_payloads_included": {"const": false},
    "external_side_effects_executed": {"const": false}
  }
}
