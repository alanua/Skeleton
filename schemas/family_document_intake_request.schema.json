{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.family_document_intake_request.v1",
  "type": "object",
  "required": ["schema", "source_kind", "idempotency_key"],
  "additionalProperties": false,
  "properties": {
