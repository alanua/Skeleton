{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/schemas/resolver-capability-manifest.schema.json",
  "title": "Skeleton Resolver Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability_id",
    "version",
    "supported_hosts",
    "input_schema",
    "output_schema",
    "dependencies",
    "network_policy",
    "timeouts",
    "response_bounds",
    "authentication",
    "test_fixtures",
    "risk",
    "approvals",
    "deploy",
    "verify",
    "rollback"
  ],
  "properties": {
    "schema": {
      "const": "skeleton.resolver_capability.manifest.v1"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "supported_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9.-]+$"
      }
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "packages", "tools", "lock"],
      "properties": {
        "python": {"type": "string"},
        "packages": {"type": "array", "items": {"type": "string"}},
        "tools": {"type": "array", "items": {"type": "string"}},
        "lock": {"type": "string"}
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssrf_guard", "allowed_hosts", "forbidden_headers", "allow_signed_media_urls"],
      "properties": {
        "ssrf_guard": {"const": true},
        "allowed_hosts": {"type": "array", "items": {"type": "string"}},
        "forbidden_headers": {"type": "array", "items": {"type": "string"}},
        "allow_signed_media_urls": {"const": false}
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 86400}
    },
    "response_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_bytes", "max_output_bytes", "max_diagnostic_bytes"],
      "properties": {
        "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "max_diagnostic_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "secret_refs"],
      "properties": {
        "required": {"type": "boolean"},
        "secret_refs": {"type": "array", "maxItems": 0}
      }
    },
    "test_fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "risk": {
      "enum": ["low", "medium", "high"]
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research", "merge", "production_activation"],
      "properties": {
        "research": {"type": "string"},
        "merge": {"type": "string"},
        "production_activation": {"type": ["string", "null"]}
      }
    },
    "deploy": {"$ref": "#/$defs/operation"},
    "verify": {"$ref": "#/$defs/operation"},
    "rollback": {"$ref": "#/$defs/operation"}
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "executor", "args"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{2,127}$"},
        "executor": {"enum": ["home_edge_exec", "runner"]},
        "args": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
