{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.travel_route_plan.schema.json",
  "title": "Provider-neutral Travel Route Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "route_plan_id",
    "origin_ref",
    "destination_ref",
    "requested_modes",
    "source_metadata",
    "alternatives"
  ],
  "properties": {
    "schema": {"const": "skeleton.travel_route_plan.v1"},
    "route_plan_id": {
      "type": "string",
      "pattern": "^travel-route-plan:[0-9a-f]{32}$"
    },
    "origin_ref": {"$ref": "#/$defs/opaque_ref"},
    "destination_ref": {"$ref": "#/$defs/opaque_ref"},
    "requested_modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/mode"}
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_revision",
        "generated_at",
        "freshness_seconds"
      ],
      "properties": {
        "source_kind": {
          "enum": ["SYNTHETIC", "USER_SUPPLIED_PUBLIC", "CACHED_PUBLIC"]
        },
        "source_revision": {"type": "integer", "minimum": 1},
        "generated_at": {"type": "integer", "minimum": 0},
        "freshness_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alternative_ref",
          "total_duration_seconds",
          "modes",
          "legs"
        ],
        "properties": {
          "alternative_ref": {"$ref": "#/$defs/opaque_ref"},
          "total_duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 604800
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/mode"}
          },
          "legs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "leg_ref",
                "leg_index",
                "mode",
                "duration_seconds",
                "source_ref"
              ],
              "properties": {
                "leg_ref": {"$ref": "#/$defs/opaque_ref"},
                "leg_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7
                },
                "mode": {"$ref": "#/$defs/mode"},
                "duration_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 604800
                },
                "source_ref": {"$ref": "#/$defs/opaque_ref"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "opaque_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$",
      "not": {
        "pattern": "(?i)(address|addr:|street|latitude|longitude|coordinate|private|google|apple|uber|lyft|booking|payment|credential|oauth)"
      }
    },
    "mode": {
      "enum": ["WALK", "BIKE", "DRIVE", "TRANSIT", "RAIL", "FLIGHT", "FERRY"]
    }
  }
}
