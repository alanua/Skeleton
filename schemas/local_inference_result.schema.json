{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.local_inference.result.v1",
  "type": "object",
  "required": ["schema", "request_id", "request_type", "status", "model", "attempt", "completed_at", "reason_codes", "output"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "skeleton.local_inference.result.v1"},
    "request_id": {"type": "string"},
    "request_type": {"type": "string"},
    "status": {"enum": ["DONE", "REVIEW"]},
    "model": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 5},
    "completed_at": {"type": "string"},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "output": {"type": "object"}
  }
}
