{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.invalid/schemas/geo_mcp_request.schema.json",
  "title": "Skeleton Geo MCP request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "arguments"],
  "properties": {
    "schema": {"const": "skeleton.geo_mcp_request.v1"},
    "operation": {"type": "string", "pattern": "^geo\\.[a-z_]+\\.[a-z_]+$"},
    "arguments": {"type": "object"},
    "idempotency_key": {"type": ["string", "null"]},
    "privacy_class": {"const": "PRIVATE_USER_GEO"}
  }
}
