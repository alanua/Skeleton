{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.five_layer_memory_activation_receipt.schema.json",
  "title": "Five Layer Private Memory Activation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "reason_codes",
    "source_sha",
    "dependency_versions",
    "backend_versions",
    "booleans",
    "aggregate_counts",
    "resource_totals",
    "rollback"
  ],
  "properties": {
    "schema": {
      "const": "skeleton.five_layer_memory_activation_receipt.v1"
    },
    "status": {
      "enum": ["DONE", "BLOCKED"]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dependency_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cognee"],
      "properties": {
        "cognee": {
          "const": "1.4.0"
        }
      }
    },
    "backend_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 128
      }
    },
    "booleans": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "aggregate_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "resource_totals": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "status"],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "status": {
          "enum": ["verified", "not_verified"]
        }
      }
    }
  }
}
