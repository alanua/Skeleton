{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.task_profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "task_class",
    "required_executor_capabilities",
    "required_model_capabilities",
    "privacy_class",
    "data_class",
    "risk_class",
    "side_effect_class",
    "deliverable",
    "validation_id",
    "budget_policy_ref",
    "timeout_policy_ref",
    "retry_policy_ref",
    "max_cost_usd",
    "max_tokens",
    "timeout_seconds",
    "max_attempts"
  ],
  "properties": {
    "operation": {"type": "string", "minLength": 1},
    "task_class": {"type": "string", "minLength": 1},
    "required_executor_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_model_capabilities": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "minLength": 1},
          {"type": "number", "minimum": 0, "maximum": 1}
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "privacy_class": {"type": "string", "minLength": 1},
    "data_class": {"type": "string", "minLength": 1},
    "risk_class": {"type": "string", "minLength": 1},
    "side_effect_class": {"type": "string", "minLength": 1},
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_changed_files", "required_artifacts", "require_tests", "require_validation", "protected_final_action"],
      "properties": {
        "min_changed_files": {"type": "integer", "minimum": 0},
        "required_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "require_tests": {"type": "boolean"},
        "require_validation": {"type": "boolean"},
        "protected_final_action": {"type": "boolean"}
      }
    },
    "validation_id": {"type": "string", "minLength": 1},
    "budget_policy_ref": {"type": "string", "minLength": 1},
    "timeout_policy_ref": {"type": "string", "minLength": 1},
    "retry_policy_ref": {"type": "string", "minLength": 1},
    "max_cost_usd": {"type": "number", "minimum": 0},
    "max_tokens": {"type": "integer", "minimum": 0},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "max_attempts": {"type": "integer", "minimum": 1}
  }
}
