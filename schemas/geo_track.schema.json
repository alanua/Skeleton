{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.invalid/schemas/geo_track.schema.json",
  "title": "Skeleton Geo track",
  "type": "object",
  "additionalProperties": false,
  "required": ["track_id", "points", "source_device_ref", "retention", "created_at", "privacy_class"],
  "properties": {
    "track_id": {"type": "string", "minLength": 1},
    "points": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["timestamp", "coordinate"], "properties": {"timestamp": {"type": "string", "minLength": 1}, "coordinate": {"type": "object", "additionalProperties": false, "required": ["lat", "lon"], "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}}}, "accuracy_m": {"type": ["number", "null"], "minimum": 0}, "speed_mps": {"type": ["number", "null"], "minimum": 0}, "heading_deg": {"type": ["number", "null"], "minimum": 0, "maximum": 359.999999}}}},
    "source_device_ref": {"type": "string", "minLength": 1},
    "retention": {"enum": ["raw_short", "derived_long", "ephemeral"]},
    "created_at": {"type": "string", "minLength": 1},
    "derived_geometry": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["lat", "lon"], "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}}}},
    "privacy_class": {"const": "PRIVATE_USER_GEO"}
  }
}
