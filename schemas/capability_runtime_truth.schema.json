{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.capability_runtime_truth.schema.json",
  "type": "object",
  "required": [
    "schema",
    "registry_authority",
    "read_model",
    "checked_at",
    "runtime_probe_performed",
    "runtime_mutation_performed",
    "summary",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "skeleton.capability_runtime_truth.v1"},
    "registry_authority": {"const": "CAPABILITY_REGISTRY.yaml"},
    "read_model": {"const": "bounded_typed_evidence_only"},
    "checked_at": {"type": "string", "minLength": 1},
    "runtime_probe_performed": {"const": false},
    "runtime_mutation_performed": {"const": false},
    "summary": {
      "type": "object",
      "required": [
        "registry_capability_count",
        "registry_available_count",
        "typed_runtime_evidence_count",
        "accepted_runtime_evidence_count",
        "derived_available_count",
        "derived_degraded_count",
        "derived_unavailable_count",
        "registry_runtime_conflict_count",
        "runtime_override_count",
        "source_present_count",
        "source_missing_count",
        "interface_usable_count"
      ],
      "additionalProperties": false,
      "properties": {
        "registry_capability_count": {"type": "integer", "minimum": 0},
        "registry_available_count": {"type": "integer", "minimum": 0},
        "typed_runtime_evidence_count": {"type": "integer", "minimum": 0},
        "accepted_runtime_evidence_count": {"type": "integer", "minimum": 0},
        "derived_available_count": {"type": "integer", "minimum": 0},
        "derived_degraded_count": {"type": "integer", "minimum": 0},
        "derived_unavailable_count": {"type": "integer", "minimum": 0},
        "registry_runtime_conflict_count": {"type": "integer", "minimum": 0},
        "runtime_override_count": {"type": "integer", "minimum": 0},
        "source_present_count": {"type": "integer", "minimum": 0},
        "source_missing_count": {"type": "integer", "minimum": 0},
        "interface_usable_count": {"type": "integer", "minimum": 0}
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "registry_status",
          "registry_lifecycle",
          "registry_declared_state",
          "registry_module",
          "registry_tested",
          "runtime_evidence",
          "runtime_states",
          "accepted_runtime_states",
          "derived_runtime_state",
          "runtime_evidence_state",
          "registry_runtime_relation",
          "source_state",
          "interface_usable",
          "live_runtime_execution",
          "reason_codes"
        ],
        "additionalProperties": false,
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "registry_status": {"type": ["string", "null"]},
          "registry_lifecycle": {"enum": ["active", "legacy", "superseded"]},
          "registry_declared_state": {
            "enum": ["declared_available", "declared_unavailable"]
          },
          "registry_module": {"type": ["string", "null"]},
          "registry_tested": {"type": "boolean"},
          "runtime_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "schema",
                "capability_id",
                "runtime_state",
                "evidence_source",
                "evidence_ref",
                "fresh",
                "verified",
                "time_current",
                "accepted_for_truth"
              ],
              "additionalProperties": false,
              "properties": {
                "schema": {"const": "skeleton.capability_runtime_evidence.v1"},
                "capability_id": {"type": "string", "minLength": 1},
                "runtime_state": {"enum": ["available", "degraded", "unavailable"]},
                "evidence_source": {"type": "string", "minLength": 1},
                "evidence_ref": {"type": "string", "minLength": 1},
                "fresh": {"type": "boolean"},
                "verified": {"type": "boolean"},
                "time_current": {"type": "boolean"},
                "accepted_for_truth": {"type": "boolean"},
                "observed_at": {"type": "string", "minLength": 1},
                "expires_at": {"type": "string", "minLength": 1}
              }
            }
          },
          "runtime_states": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["available", "degraded", "unavailable"]}
          },
          "accepted_runtime_states": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["available", "degraded", "unavailable"]}
          },
          "derived_runtime_state": {"enum": ["available", "degraded", "unavailable"]},
          "runtime_evidence_state": {
            "enum": [
              "no_runtime_evidence",
              "accepted_runtime_evidence",
              "stale_runtime_evidence"
            ]
          },
          "registry_runtime_relation": {
            "enum": [
              "registry_only",
              "runtime_matches_registry",
              "runtime_overrides_registry",
              "runtime_conflicts_with_registry",
              "runtime_not_accepted"
            ]
          },
          "source_state": {"enum": ["present", "missing", "not_checked"]},
          "interface_usable": {"type": "boolean"},
          "live_runtime_execution": {"type": "boolean"},
          "reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
          }
        }
      }
    }
  }
}
