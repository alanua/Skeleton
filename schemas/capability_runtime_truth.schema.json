{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.capability_runtime_truth.schema.json",
  "type": "object",
  "required": [
    "schema",
    "registry_authority",
    "read_model",
    "checked_at",
    "runtime_probe_performed",
    "runtime_mutation_performed",
    "summary",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "skeleton.capability_runtime_truth.v1"},
    "registry_authority": {"const": "CAPABILITY_REGISTRY.yaml"},
    "read_model": {"const": "bounded_typed_evidence_only"},
    "checked_at": {"type": "string", "minLength": 1},
    "runtime_probe_performed": {"const": false},
    "runtime_mutation_performed": {"const": false},
    "summary": {
      "type": "object",
      "required": [
        "registry_capability_count",
        "registry_available_count",
        "typed_runtime_evidence_count",
        "fresh_verified_runtime_evidence_count",
        "effective_available_count",
        "drift_count",
        "parity_match_count",
        "source_present_count",
        "source_missing_count",
        "interface_usable_count"
      ],
      "additionalProperties": false,
      "properties": {
        "registry_capability_count": {"type": "integer", "minimum": 0},
        "registry_available_count": {"type": "integer", "minimum": 0},
        "typed_runtime_evidence_count": {"type": "integer", "minimum": 0},
        "fresh_verified_runtime_evidence_count": {"type": "integer", "minimum": 0},
        "effective_available_count": {"type": "integer", "minimum": 0},
        "drift_count": {"type": "integer", "minimum": 0},
        "parity_match_count": {"type": "integer", "minimum": 0},
        "source_present_count": {"type": "integer", "minimum": 0},
        "source_missing_count": {"type": "integer", "minimum": 0},
        "interface_usable_count": {"type": "integer", "minimum": 0}
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "registry_status",
          "registry_effective_state",
          "registry_lifecycle",
          "registry_module",
          "registry_tested",
          "live_runtime_execution",
          "runtime_evidence",
          "runtime_states",
          "fresh_verified_runtime_states",
          "effective_state",
          "freshness",
          "drift",
          "parity",
          "source_presence",
          "interface_usable",
          "evidence_binding",
          "reason_codes"
        ],
        "additionalProperties": false,
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "registry_status": {"type": ["string", "null"]},
          "registry_effective_state": {
            "enum": ["available", "unavailable"]
          },
          "registry_lifecycle": {
            "enum": ["active", "legacy", "superseded"]
          },
          "registry_module": {"type": ["string", "null"]},
          "registry_tested": {"type": "boolean"},
          "live_runtime_execution": {"type": "boolean"},
          "runtime_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "schema",
                "capability_id",
                "runtime_state",
                "source",
                "evidence_ref",
                "fresh",
                "verified",
                "time_fresh",
                "fresh_verified"
              ],
              "additionalProperties": false,
              "properties": {
                "schema": {"const": "skeleton.capability_runtime_evidence.v1"},
                "capability_id": {"type": "string", "minLength": 1},
                "runtime_state": {
                  "enum": ["available", "degraded", "unavailable"]
                },
                "source": {"type": "string", "minLength": 1},
                "evidence_ref": {"type": "string", "minLength": 1},
                "fresh": {"type": "boolean"},
                "verified": {"type": "boolean"},
                "time_fresh": {"type": "boolean"},
                "fresh_verified": {"type": "boolean"},
                "observed_at": {"type": "string", "minLength": 1},
                "expires_at": {"type": "string", "minLength": 1}
              }
            }
          },
          "runtime_states": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["available", "degraded", "unavailable"]}
          },
          "fresh_verified_runtime_states": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["available", "degraded", "unavailable"]}
          },
          "effective_state": {
            "enum": ["available", "degraded", "unavailable"]
          },
          "freshness": {
            "enum": [
              "no_runtime_evidence",
              "fresh_verified_runtime_evidence",
              "stale_or_unverified_runtime_evidence"
            ]
          },
          "drift": {
            "enum": [
              "not_evaluated_without_fresh_evidence",
              "no_drift",
              "runtime_overrides_stale_registry",
              "runtime_conflicts_with_registry"
            ]
          },
          "parity": {
            "enum": [
              "registry_only",
              "registry_runtime_parity",
              "registry_runtime_drift"
            ]
          },
          "source_presence": {
            "enum": ["present", "missing", "not_checked"]
          },
          "interface_usable": {"type": "boolean"},
          "evidence_binding": {
            "enum": ["no_runtime_evidence", "all_runtime_evidence_bound"]
          },
          "reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
          }
        }
      }
    }
  }
}
