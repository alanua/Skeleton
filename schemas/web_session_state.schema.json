{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.web_session_state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binding",
    "current_url",
    "status",
    "pending_challenge"
  ],
  "properties": {
    "schema": {
      "const": "skeleton.web_session_state.v1"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "session_id",
        "session_epoch",
        "origin"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^sess:[a-z0-9][a-z0-9_.:-]{2,95}$"
        },
        "session_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]{1,120}(?::[0-9]{2,5})?$"
        }
      }
    },
    "current_url": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{2,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&\\x27()*+,;=%-]*)?$",
      "maxLength": 228
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "waiting_for_operator",
        "resumed",
        "closed"
      ]
    },
    "pending_challenge": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "challenge_id",
            "reason",
            "page_url",
            "reason_code",
            "resume_token"
          ],
          "properties": {
            "challenge_id": {
              "type": "string",
              "pattern": "^(?:captcha|challenge):[a-z0-9][a-z0-9_.:-]{2,95}$"
            },
            "reason": {
              "type": "string",
              "enum": [
                "captcha",
                "mfa",
                "oauth_consent",
                "account_selection",
                "site_consent",
                "manual_review",
                "unknown_interactive_challenge"
              ]
            },
            "page_url": {
              "type": "string",
              "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{2,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&\\x27()*+,;=%-]*)?$",
              "maxLength": 228
            },
            "reason_code": {
              "enum": [
                "CAPTCHA_OPERATOR_HANDOFF_REQUIRED",
                "MFA_OPERATOR_HANDOFF_REQUIRED",
                "OAUTH_CONSENT_OPERATOR_HANDOFF_REQUIRED",
                "ACCOUNT_SELECTION_OPERATOR_HANDOFF_REQUIRED",
                "SITE_CONSENT_OPERATOR_HANDOFF_REQUIRED",
                "MANUAL_REVIEW_OPERATOR_HANDOFF_REQUIRED",
                "UNKNOWN_INTERACTIVE_CHALLENGE_OPERATOR_HANDOFF_REQUIRED"
              ]
            },
            "resume_token": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "waiting_for_operator"
          }
        }
      },
      "then": {
        "properties": {
          "pending_challenge": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "pending_challenge": {
            "type": "null"
          }
        }
      }
    }
  ]
}
