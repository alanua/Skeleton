{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.web_session_state.schema.json",
  "type": "object",
  "required": [
    "schema",
    "binding",
    "current_url",
    "status",
    "pending_challenge"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "skeleton.web_session_state.v1"
    },
    "binding": {
      "type": "object",
      "required": [
        "provider_id",
        "session_id",
        "session_epoch",
        "origin"
      ],
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^sess:[a-z0-9][a-z0-9_.:-]{2,95}$"
        },
        "session_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]{1,120}(:[0-9]{2,5})?$"
        }
      }
    },
    "current_url": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]{1,220}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "waiting_for_operator",
        "resumed",
        "closed"
      ]
    },
    "pending_challenge": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "challenge_id",
            "page_url",
            "reason_code",
            "resume_token"
          ],
          "additionalProperties": false,
          "properties": {
            "challenge_id": {
              "type": "string",
              "pattern": "^captcha:[a-z0-9][a-z0-9_.:-]{2,95}$"
            },
            "page_url": {
              "type": "string",
              "pattern": "^https://[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]{1,220}$"
            },
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Z0-9_]{3,80}$"
            },
            "resume_token": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "waiting_for_operator"
          }
        }
      },
      "then": {
        "properties": {
          "pending_challenge": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "pending_challenge": {
            "type": "null"
          }
        }
      }
    }
  ]
}
