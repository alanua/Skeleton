{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skeleton Runner vNext Operation Ledger Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","sequence","operation_id","idempotency_key","target_state_ref","event_type","fence_token","reason_code","touched_resource_refs"],
  "properties": {
    "schema": {"const":"skeleton.runner_operation_ledger_event.v1"},
    "sequence": {"type":"integer","minimum":1},
    "operation_id": {"type":"string","minLength":1},
    "idempotency_key": {"type":"string","minLength":1},
    "target_state_ref": {"type":"string","minLength":1},
    "event_type": {"enum":["RESERVED","FENCE_REBOUND","COMPLETED","FAILED"]},
    "fence_token": {"type":"integer","minimum":1},
    "reason_code": {"type":"string","pattern":"^[A-Z0-9_]+$"},
    "touched_resource_refs": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "before_state_ref": {"type":["string","null"]},
    "after_state_ref": {"type":["string","null"]},
    "validation_status": {"enum":["PASS","FAIL",null]},
    "external_dedupe_nonce": {"type":["string","null"],"maxLength":128}
  }
}
