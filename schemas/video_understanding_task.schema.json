{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/schemas/video_understanding_task.schema.json",
  "title": "Skeleton Video Understanding Task",
  "type": "object",
  "required": ["schema", "task_id", "idempotency_key", "operation", "payload", "state", "attempts", "available_at", "lease_until", "worker_id", "reason_code", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "skeleton.video_understanding.task.v1"},
    "task_id": {"type": "string", "pattern": "^vut_[0-9a-f]{32}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 4096},
    "operation": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "payload": {"type": "object"},
    "state": {"enum": ["pending", "processing", "done", "review", "retry", "quarantined"]},
    "attempts": {"type": "integer", "minimum": 0},
    "available_at": {"type": "number"},
    "lease_until": {"type": ["number", "null"]},
    "worker_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "reason_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
    "created_at": {"type": "number"},
    "updated_at": {"type": "number"}
  }
}
