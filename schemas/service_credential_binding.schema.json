{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/schemas/service_credential_binding.schema.json",
  "title": "Skeleton Service Credential Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bindings"],
  "properties": {
    "schema": {
      "const": "skeleton.service_credentials.v1"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service_id",
          "alias",
          "reference",
          "context",
          "action_id",
          "adapter_id",
          "target_id"
        ],
        "properties": {
          "service_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{1,127}$"
          },
          "alias": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{1,127}$"
          },
          "reference": {
            "$ref": "secret_reference.schema.json"
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["machine_identity", "audience", "task_kind"],
            "properties": {
              "machine_identity": {"type": "string", "minLength": 1, "maxLength": 128},
              "audience": {"type": "string", "minLength": 1, "maxLength": 128},
              "task_kind": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          },
          "action_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{1,127}$"
          },
          "adapter_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{1,127}$"
          },
          "target_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{1,127}$"
          },
          "required": {"type": "boolean", "default": true},
          "reload_mode": {
            "type": "string",
            "enum": ["per_use", "restart"],
            "default": "per_use"
          }
        }
      }
    }
  }
}
