{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.reading.public_source_search_response.schema.json",
  "title": "Skeleton Reading Public Source Search Response",
  "type": "object",
  "required": [
    "schema",
    "query",
    "privacy_boundary",
    "automated_downloads",
    "results",
    "source_health"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "skeleton.reading.public_source_search_response.v1"},
    "query": {"type": "string", "minLength": 2, "maxLength": 160},
    "privacy_boundary": {"const": "PUBLIC_SAFE_WEB_METADATA_ONLY"},
    "automated_downloads": {"const": false},
    "results": {
      "type": "array",
      "items": {"$ref": "#/$defs/result"}
    },
    "source_health": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_health"}
    }
  },
  "$defs": {
    "public_url": {
      "type": "string",
      "pattern": "^https?://[^\\s@/]+.*$"
    },
    "result": {
      "type": "object",
      "required": [
        "schema",
        "source_id",
        "source_result_id",
        "title",
        "authors",
        "isbn",
        "media_kind",
        "source_url",
        "cover_url",
        "cover_status",
        "dedupe_key",
        "matched_source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "skeleton.reading.public_source_result.v1"},
        "source_id": {"enum": ["public.4read.org", "public.akniga.org", "public.knigavuhe.org"]},
        "source_result_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "isbn": {
          "type": ["string", "null"],
          "pattern": "^[0-9X]{10}$|^[0-9]{13}$"
        },
        "media_kind": {"enum": ["ebook", "audiobook"]},
        "source_url": {"$ref": "#/$defs/public_url"},
        "cover_url": {
          "oneOf": [
            {"$ref": "#/$defs/public_url"},
            {"const": "skeleton://reading/cover-placeholder/neutral"}
          ]
        },
        "cover_status": {"enum": ["source", "enriched", "placeholder"]},
        "dedupe_key": {"type": "string", "minLength": 1, "maxLength": 400},
        "matched_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["public.4read.org", "public.akniga.org", "public.knigavuhe.org"]}
        }
      }
    },
    "source_health": {
      "type": "object",
      "required": ["schema", "source_id", "status", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "skeleton.reading.public_source_health.v1"},
        "source_id": {"enum": ["public.4read.org", "public.akniga.org", "public.knigavuhe.org"]},
        "status": {"enum": ["OK", "BLOCKED"]},
        "reason_code": {"type": ["string", "null"], "maxLength": 80}
      }
    }
  }
}
