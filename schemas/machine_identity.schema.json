{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/machine_identity.schema.json",
  "title": "Skeleton Machine Identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "machine_id",
    "node_class",
    "key_id",
    "key_version",
    "public_fingerprint",
    "transport_profiles",
    "capabilities",
    "issued_at",
    "expires_at",
    "last_verified_at"
  ],
  "properties": {
    "machine_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,63}$"},
    "node_class": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,63}$"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{2,127}$"},
    "key_version": {"type": "integer", "minimum": 1},
    "public_fingerprint": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:+/=_-]{15,255}$"},
    "transport_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,95}$"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,95}$"}
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "last_verified_at": {"type": "string", "format": "date-time"}
  }
}
