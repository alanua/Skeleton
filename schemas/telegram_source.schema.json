{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.telegram_source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "handle", "access_modes", "operator_secret_route"],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "handle": {
      "type": "string",
      "minLength": 1
    },
    "peer_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "access_modes": {
      "type": "array",
      "items": {
        "enum": ["READ_PUBLIC", "READ_ALLOWED_PRIVATE", "WRITE_BOT"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "secret_refs": {
      "type": "array",
      "items": {
        "enum": [
          "telegram_api_id",
          "telegram_api_hash",
          "telegram_bot_token",
          "telegram_mtproto_string_session"
        ]
      },
      "uniqueItems": true
    },
    "allowlisted_peer_ids": {
      "type": "array",
      "description": "Exact private peers allowed for READ_ALLOWED_PRIVATE. Stable peer_id entries are accepted even when the public handle is not listed.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "max_page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "operator_secret_route": {
      "const": "home_edge_devices_secrets_tab_to_bitwarden"
    },
    "media_downloads_default": {
      "const": false
    }
  }
}
