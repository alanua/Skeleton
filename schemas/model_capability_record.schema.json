{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/schemas/model_capability_record.schema.json",
  "title": "Skeleton Model Capability Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id", "status", "score", "canary_passed", "promotion_stage"],
  "properties": {
    "capability_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["LIVE", "DEGRADED", "COOLDOWN", "DISABLED", "UNSUPPORTED"]},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "canary_passed": {"type": "boolean"},
    "promotion_stage": {
      "enum": ["DISCOVERED", "CANARY_ONLY", "ELIGIBLE", "LIVE", "DEGRADED", "UNSUPPORTED", "BLOCKED"]
    },
    "hard_failures": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"promotion_stage": {"enum": ["ELIGIBLE", "LIVE"]}}, "required": ["promotion_stage"]},
      "then": {
        "properties": {
          "status": {"const": "LIVE"},
          "canary_passed": {"const": true},
          "hard_failures": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"promotion_stage": {"enum": ["DISCOVERED", "CANARY_ONLY"]}}, "required": ["promotion_stage"]},
      "then": {"properties": {"canary_passed": {"const": false}}}
    }
  ]
}
