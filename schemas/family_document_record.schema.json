{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.family_document_record.schema.json",
  "type": "object",
  "required": [
    "schema",
    "record_id",
    "source_kind",
    "source_id",
    "source_sha256",
    "ocr_text_hash",
    "record_hash"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "skeleton.family_document_record.v1"
    },
    "record_id": {
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "mfp",
        "local_file",
        "drive"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ocr_text_hash": {
      "type": "string"
    },
    "record_hash": {
      "type": "string"
    },
    "classification": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "bank_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bank",
            "form_type",
            "product_type",
            "account_owner_alias",
            "fees",
            "conditions"
          ],
          "properties": {
            "bank": {
              "const": "Mittelbrandenburgische Sparkasse"
            },
            "form_type": {
              "enum": [
                "girovertrag",
                "kontovertrag",
                null
              ]
            },
            "product_type": {
              "enum": [
                "Girokonto",
                null
              ]
            },
            "account_owner_alias": {
              "type": [
                "string",
                "null"
              ]
            },
            "fees": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "amount",
                  "currency",
                  "period"
                ],
                "properties": {
                  "amount": {
                    "type": "string",
                    "pattern": "^\\d+(?:\\.\\d{2})?$"
                  },
                  "currency": {
                    "const": "EUR"
                  },
                  "period": {
                    "const": "month"
                  }
                }
              }
            },
            "conditions": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}