  "properties": {
    "schema": {"const": "skeleton.family_document_record.v1"},
    "document_id": {"type": "string"},
    "session_id": {"type": "string"},
    "document_sequence": {"type": "integer", "minimum": 1},
    "source_identity": {"type": "string"},
    "assembled_pdf": {"type": "string"},
    "assembled_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "page_count": {"type": "integer", "minimum": 1},
    "readback_verified_before_ocr": {"const": true},
    "separator_pages_removed": {"type": "integer", "minimum": 0},
    "components": {"type": "array"},
    "page_provenance": {"type": "array"}
  },
  "additionalProperties": true
}
