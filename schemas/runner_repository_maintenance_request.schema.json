{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skeleton/runner_repository_maintenance_request.schema.json",
  "title": "Runner Repository Maintenance Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maintenance_task_id", "idempotency_key"],
  "properties": {
    "schema": {"const": "skeleton.runner_repository_maintenance_request.v1"},
    "maintenance_task_id": {
      "type": "string",
      "enum": ["approved_pr_merge", "remote_read_only_diagnostic"]
    },
    "pr_number": {"type": "integer", "minimum": 1},
    "expected_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "operator_approval": {"type": "string", "minLength": 1, "maxLength": 256},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "allOf": [
    {
      "if": {"properties": {"maintenance_task_id": {"const": "approved_pr_merge"}}},
      "then": {"required": ["pr_number", "expected_head_sha", "operator_approval"]}
    }
  ]
}
