{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alanua/Skeleton/schemas/runner_repository_maintenance_request.schema.json",
  "title": "Skeleton Runner Repository Maintenance Request",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "repository",
        "pr_number",
        "approved_head_sha",
        "reviewed_files",
        "approval_source",
        "callback_digest",
        "merge_action"
      ],
      "properties": {
        "schema": {
          "const": "skeleton.runner_repository_maintenance_request.v1"
        },
        "operation": {
          "const": "approved_pr_merge"
        },
        "repository": {
          "const": "alanua/Skeleton"
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "approved_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "reviewed_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\/$)[A-Za-z0-9._-][A-Za-z0-9._/@+\\-]{0,511}$"
          }
        },
        "approval_source": {
          "const": "signed_telegram_callback"
        },
        "callback_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "merge_action": {
          "const": "squash"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "node_id",
        "probe_profile"
      ],
      "properties": {
        "schema": {
          "const": "skeleton.runner_repository_maintenance_request.v1"
        },
        "operation": {
          "const": "remote_read_only_diagnostic"
        },
        "node_id": {
          "const": "home-edge-01"
        },
        "probe_profile": {
          "const": "de_pc_read_only_v1"
        }
      }
    }
  ]
}
