{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Skeleton Runner vNext GREEN Execution Grant","type":"object","additionalProperties":false,"required":["schema","task_id","node_id","node_generation","node_snapshot_hash","node_attestation_ref","lane","fence_token","environment_policy_hash","operation_id","idempotency_key","adapter_id","reservation_scope_hash","planner_envelope_hash","policy_reason_code","authorization_status","execution_authorized","effect_execution_started"],"properties":{"schema":{"const":"skeleton.runner_green_execution_grant.v1"},"task_id":{"type":"string","pattern":"^task:[A-Za-z0-9._-]+$"},"node_id":{"type":"string","pattern":"^node:[A-Za-z0-9._-]+$"},"node_generation":{"type":"integer","minimum":1},"node_snapshot_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"node_attestation_ref":{"type":"string","minLength":3},"lane":{"enum":["codegen","validate","publish","merge","control","privileged"]},"fence_token":{"type":"integer","minimum":1},"environment_policy_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"operation_id":{"type":"string","minLength":3},"idempotency_key":{"type":"string","minLength":3},"adapter_id":{"type":"string","minLength":3},"reservation_scope_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"planner_envelope_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"policy_reason_code":{"type":"string","pattern":"^[A-Z0-9_]+$"},"authorization_status":{"const":"AUTHORIZED_GREEN_BOUNDED"},"execution_authorized":{"const":true},"effect_execution_started":{"const":false}}}
