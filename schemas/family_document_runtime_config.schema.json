{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/schemas/family_document_runtime_config.schema.json",
  "title": "Private family document runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "people", "approved_roots", "archive_root", "journal_path", "projection_outbox_path", "receipt_outbox_path", "worker_lock_path",
    "memory_command", "calendar_command", "approval_ref", "ocr_executables"
  ],
  "properties": {
    "people": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "object", "additionalProperties": false, "required": ["person_id", "aliases"], "properties": {"person_id": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}
    },
    "approved_roots": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["alias", "path"], "properties": {"alias": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}}},
    "archive_root": {"type": "string", "minLength": 1},
    "journal_path": {"type": "string", "minLength": 1},
    "projection_outbox_path": {"type": "string", "minLength": 1},
    "receipt_outbox_path": {"type": "string", "minLength": 1},
    "worker_lock_path": {"type": "string", "minLength": 1},
    "memory_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "calendar_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approval_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "ocr_executables": {"type": "object", "additionalProperties": false, "required": ["pdftotext", "ocrmypdf", "tesseract", "libreoffice"], "properties": {"pdftotext": {"type": "string", "pattern": "^/"}, "ocrmypdf": {"type": "string", "pattern": "^/"}, "tesseract": {"type": "string", "pattern": "^/"}, "libreoffice": {"type": "string", "pattern": "^/"}}},
    "ocr_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "ocr_max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 20000000},
    "ocr_languages": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{2,16}$"}},
    "record_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "settle_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
    "lease_seconds": {"type": "integer", "minimum": 30, "maximum": 86400},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
    "retry_base_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "max_inventory_files": {"type": "integer", "minimum": 1, "maximum": 100000}
  }
}
