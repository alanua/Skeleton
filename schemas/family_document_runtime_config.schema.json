{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.family_document_runtime_config.v1",
  "type": "object",
  "required": ["schema", "inbox_roots", "archive_root", "runtime_root", "quarantine_root", "subject_aliases"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "skeleton.family_document_runtime_config.v1"},
    "inbox_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "archive_root": {"type": "string"},
    "runtime_root": {"type": "string"},
    "quarantine_root": {"type": "string"},
    "subject_aliases": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "stable_age_seconds": {"type": "number", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
    "backoff_seconds": {"type": "number", "minimum": 0},
    "approval_ref": {"type": "string"}
  }
}
