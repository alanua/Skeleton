  "$id": "skeleton.family_document_receipt.schema.json",
  "type": "object",
  "required": ["schema", "receipt_key", "receipt_type", "record_id"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "skeleton.family_document_receipt.v1"},
    "receipt_key": {"type": "string"},
    "receipt_type": {"enum": ["intake", "terminal"]},
    "intake_id": {"type": "string"},
    "record_id": {"type": "string"},
    "record_hash": {"type": "string"},
    "status": {"type": "string"}
  }
}
