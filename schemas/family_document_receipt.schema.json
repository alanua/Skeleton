{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skeleton.family_document_receipt.schema.json",
  "type": "object",
  "required": ["schema", "receipt_key", "receipt_type"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "skeleton.family_document_receipt.v1"},
    "receipt_key": {"type": "string", "minLength": 1},
    "receipt_type": {"enum": ["intake", "terminal", "package_part"]},
    "intake_id": {"type": "string"},
    "record_id": {"type": "string", "minLength": 1},
    "record_hash": {"type": "string"},
    "status": {"type": "string", "minLength": 1},
    "package_key": {"type": "string", "minLength": 1},
    "part_index": {"type": "integer", "minimum": 1},
    "part_count": {"type": "integer", "minimum": 1},
    "message": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "allOf": [
    {
      "if": {
        "properties": {"receipt_type": {"const": "package_part"}},
        "required": ["receipt_type"]
      },
      "then": {
        "required": ["package_key", "part_index", "part_count", "status", "message"]
      },
      "else": {
        "required": ["record_id"]
      }
    }
  ]
}
