+def _media_saved_episode_identity(item: dict) -> tuple[str, str, str]:
+    # Preserve exact compound episode identity; never truncate a range.
+    key = str(item.get('episode_key') or '').strip()
+    if not key:
+        season = str(item.get('season') or '').strip()
+        episode = str(item.get('episode') or '').strip()
