+def _history_partition_conflicting_groups(groups: dict) -> dict:
+    result = {}
+    for key, group in groups.items():
+        rows = group.get('jobs') or []
+        buckets = {}
+        for stamp, job in rows:
+            identity = _history_stable_identity(job)
+            buckets.setdefault(identity, []).append((stamp, job))
+        known = {identity for identity in buckets if identity}
+        if len(known) <= 1:
+            result[key] = group
+            continue
+        for identity, members in sorted(buckets.items()):
+            # Unknown identity is isolated, never assigned to a known work.
+            suffix = hashlib.sha256((identity or 'unresolved').encode()).hexdigest()[:16]
+            split_key = key + '|identity:' + suffix
+            if split_key in groups or split_key in result:
+                raise RuntimeError('HISTORY_IDENTITY_KEY_COLLISION')
+            result[split_key] = {
+                **group, 'key': split_key, 'jobs': members,
+                'legacy_collision_key': key, 'stable_identity': identity,
+                'years': {int((j.get('catalog') or {}).get('year') or 0)
+                          for _, j in members
+                          if str((j.get('catalog') or {}).get('year') or '').isdigit()
+                          and int((j.get('catalog') or {}).get('year') or 0)>0},
+            }
+    return result
+
