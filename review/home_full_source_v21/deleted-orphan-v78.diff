+def _media_orphan_is_deleted(item: dict, deleted: dict) -> bool:
+    # Only an exact retained job can prove a tombstone. Never infer deletion
+    # from a watch-row title, or remove the underlying watch ledger.
+    for field in ('last_job_id', 'job_id'):
+        jid = str(item.get(field) or '').strip()
+        if not re.fullmatch(r'[A-Za-z0-9_-]+', jid):
+            continue
+        try:
+            job = _load(jid)
+        except Exception:
+            continue
+        if not isinstance(job, dict) or str(job.get('job_id') or '') != jid:
+            continue
+        key = _history_job_key(job)
+        deleted_at = int(deleted.get(key) or 0)
+        if deleted_at and float(job.get('user_requested_at') or 0) <= deleted_at:
+            return True
+    return False
+
