[Unit]
Description=Skeleton GitHub Task Queue Poller
After=network.target

[Service]
Type=oneshot
User=agent
WorkingDirectory=/home/agent/agent-dev/repos/Skeleton
EnvironmentFile=-/etc/skeleton-runner.env
LoadCredentialEncrypted=bitwarden-access-token:/etc/skeleton/credstore.encrypted/bitwarden-access-token.cred
LoadCredentialEncrypted=skeleton-secret-reference-index:/etc/skeleton/credstore.encrypted/skeleton-secret-reference-index.cred
ExecStart=/usr/bin/python3 scripts/runner_poll_github_tasks.py
StandardOutput=journal
StandardError=journal
